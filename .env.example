# ==============================================================
# MARVEL // ZERO-G ENVIRONMENT CONFIGURATION
# ==============================================================

# --- BACKEND (Render Web Service) ---
# Your secret TMDB API Read Access Token or API v3 Key.
# Set this in your Render Service Dashboard under "Environment Variables".
# NEVER prefix with VITE_ or expose to client browsers.
TMDB_API_KEY=your_tmdb_api_key_or_bearer_token_here

# (Optional) Port and CORS Allowed Origins for the Render server:
PORT=5000
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# --- FRONTEND (Vercel Production & Local Development) ---
# Public URL of the dedicated Render backend.
# Set this in your Vercel Project Settings under "Environment Variables":
# e.g. https://marvel-zero-g-api.onrender.com
VITE_API_BASE_URL=https://marvel-aytt.onrender.com
